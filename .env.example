# === CampaignForge AI — Environment Variables ===

# App
APP_ENV=dev
DEBUG=true

# OAuth token encryption (Fernet). Required when APP_ENV is not dev.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In dev, if omitted, a built-in development key is used (not for production).
TOKEN_ENCRYPTION_KEY=

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campaignforge
NEON_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_EXPIRE_MINUTES=60

# Clerk (set on Vercel). If unset, backend accepts JWT from POST /auth/login (pairs with seeded users in db/seed.sql).
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Optional: first Clerk sign-in for these emails uses the demo org from db/seed.sql (see DEMO_ORG_ID there).
# DEMO_ORG_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
# DEMO_ORG_ALLOWLIST=you@company.com

# === LLM Providers (at least one API key required) ===
# A provider with a blank key is skipped. The first configured provider in the
# order below serves each tier; the rest become live fallbacks, so a transient
# 503 from one gateway does not fail the campaign. See services/llm_provider.py.

# Native SDK providers
ANTHROPIC_API_KEY=
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
GOOGLE_API_KEY=
# gemini-2.0-flash is rate-limited on free-tier keys; 2.5-flash is the default.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible providers (all routed through ChatOpenAI + base_url)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

BONSAI_API_KEY=
BONSAI_BASE_URL=https://api.trybons.ai/v1
BONSAI_MODEL=gpt-4o-mini

# Preference order. Blank = anthropic,google,openai,nvidia,openrouter,bonsai
LLM_PROVIDER_ORDER=

# Pin a provider to one tier (disables fallback for that tier).
# Tiers: brain = Orchestrator + QA, worker = Strategy/SEO/Content, ad_copy = Ad Copy.
LLM_BRAIN_PROVIDER=
LLM_WORKER_PROVIDER=
LLM_AD_COPY_PROVIDER=

# Override the model for a tier (applies to the primary provider only).
LLM_BRAIN_MODEL=
LLM_WORKER_MODEL=
LLM_AD_COPY_MODEL=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_DEFAULT_DOMAIN=

# Storage (S3/R2 for media)
S3_BUCKET_NAME=campaignforge-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
