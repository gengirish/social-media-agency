# Claude Code - Project-Level Environment Variables
#
# Copy to .claude/.env and fill in. Precedence: process.env > .claude/.env
# .env is already covered by the repo .gitignore - never commit real keys.
#
# Nothing here is required for the marketing agency layer (agents, commands,
# skills, workflows) to work. These only matter if you wire up the optional
# integrations below.

# ============================================
# Gemini (used by skills that call Google models directly)
# ============================================
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ==== Vertex AI (optional, instead of AI Studio) ====
# GEMINI_USE_VERTEX=true
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1

# ============================================
# MCP server credentials
# ============================================
# Referenced as ${VAR} from .mcp.json - see .claude/mcp.json.example.
# Uncomment only the servers you actually enable.
# CONTEXT7_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SE_RANKING_API_KEY=
# METRICOOL_API_KEY=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_DESTINATION_USER_ID=
# MAILTRAP_API_TOKEN=
# NOTION_API_KEY=
# STRIPE_SECRET_KEY=

# ============================================
# Notification hooks (NOT configured in this repo)
# ============================================
# There is no .claude/hooks/ directory and no hooks block in settings.json.
# Setting these alone does nothing. To use them, first add a hook in
# .claude/settings.json - see https://docs.claude.com/en/docs/claude-code/hooks
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ============================================
# Application secrets do NOT belong here
# ============================================
# Backend/frontend config lives in backend/.env and frontend/.env.local.
# See CLAUDE.md for NEON_DATABASE_URL, DATABASE_URL, LLM_PROVIDER_ORDER, Clerk, etc.
