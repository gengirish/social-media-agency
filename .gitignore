# Archify (third-party diagram skill). Pinned by skills-lock.json and
# reinstalled with: npx skills add tt-a1i/archify --agent claude-code --copy
# Vendored copy is ~7.5MB of examples/tests, so it is not tracked.
.claude/skills/archify/

# Archify visual-check artifacts, regenerated by `archify visual-check`
docs/diagrams/*.visual-check.*

.mypy_cache/

# Installed agent skills are real files in .agents/; this is a machine-absolute symlink.
.claude/skills/build-with-exa
