  "cards": [
    {
      "dot": "cyan",
      "title": "The pipeline pauses for a human",
      "items": [
        "Compiled with interrupt_before on human_review",
        "Graph state is checkpointed to Postgres, so a paused campaign survives a restart",
        "Resumes on PATCH /campaigns/{id}/review"
      ]
    },
    {
      "dot": "amber",
      "title": "Honest by construction",
      "items": [
        "Unmeasurable values return null plus a reason, never a plausible number",
        "Instagram and TikTok are drafted and scheduled, never silently 'published'",
        "Industry benchmarks are suppressed below 5 contributing orgs"
      ]
    }
