    {
      "dot": "cyan",
      "title": "The pause is real",
      "items": [
        "Compiled with interrupt_before on human_review",
        "State is checkpointed to Postgres, so a paused run survives a restart",
        "Resumes only on PATCH /campaigns/{id}/review"
      ]
    },
    {
      "dot": "amber",
      "title": "Two loops, both bounded",
      "items": [
        "Reviewer routes to revise_content or revise_ads",
        "Critical QA failures re-run the writer, capped at retry_count >= 2",
        "An unreviewed resume records auto_approved_no_human, never 'approved'"
      ]
    },
    {
      "dot": "violet",
      "title": "Model tiers and fan-in",
      "items": [
        "Orchestrator and QA/Brand run on the brain tier at 0.3",
        "Strategy, SEO and Content run on the worker tier at 0.7; Ad copy at 0.8",
        "Content and Ad copy both consume Strategy and SEO output"
