# ============================================================================
# CampaignForge AI — backend/.env.example
#
# Usage:   cd backend && cp .env.example .env   (then fill in ONE LLM key)
#          uvicorn agency.main:app --reload --port 8001
#
# Mirrors every field in backend/src/agency/config.py (Settings). Each comment
# says what breaks or turns off when the value is blank.
#
# WARNING — do not add keys that are not fields in Settings. pydantic-settings
# runs with extra="forbid", so ONE unknown key in .env aborts startup with
# "Extra inputs are not permitted". (The repo-root .env.example contains
# NEXT_PUBLIC_API_URL, which is a frontend var — copying that file into
# backend/.env will NOT boot. Use this file instead.)
#
# WARNING — a blank value is NOT the same as an unset key. Settings reads ""
# from the file rather than falling back to the code default, so every var
# below that has a real default is written out with that default. Blanking
# DEBUG or JWT_EXPIRE_MINUTES is a type error at startup, not a fallback.
#
# Placeholders only. Never commit a real secret. .env is gitignored.
# ============================================================================

# ----------------------------------------------------------------------------
# MINIMUM TO BOOT
# ----------------------------------------------------------------------------
# Copy this file, then set only these four to run locally:
#
#   DATABASE_URL       — app database (default below works with docker compose)
#   NEON_DATABASE_URL  — LangGraph checkpointer; blank = campaigns lost on restart
#   JWT_SECRET         — local HS256 login; the default is a known string
#   one LLM key        — ANTHROPIC_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY,
#                        NVIDIA_NIM_API_KEY, OPENROUTER_API_KEY, or BONSAI_API_KEY.
#                        With none set, the API still starts, but the first agent
#                        call raises "No LLM provider is configured".
#
# Everything else below is optional and degrades a specific feature, not boot.
# ----------------------------------------------------------------------------


# === App ====================================================================

# dev | staging | prod. Blank/"dev" enables the built-in dev Fernet fallback
# for TOKEN_ENCRYPTION_KEY (utils/encryption.py). "prod" forces TLS on the
# database connection even for non-Neon hosts (models/database.py).
APP_ENV=dev

# SQLAlchemy engine echo. true logs every SQL statement. Must be a bool —
# a blank value is a validation error at startup, not "off".
DEBUG=true


# === Database (Neon PostgreSQL) =============================================

# Main app database (SQLAlchemy + asyncpg). Blank is a startup error; a wrong
# value fails on the first request that touches the DB. The prefix is
# normalized to postgresql+asyncpg:// automatically. Hosts containing
# "neon.tech" get TLS applied automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/campaignforge

# Separate DSN for the LangGraph checkpointer, which uses psycopg (sync-style
# DSN) rather than asyncpg. BLANK = the checkpointer SILENTLY falls back to
# MemorySaver: campaigns do NOT survive a restart, and a paused human_review
# cannot be resumed after one. Look for the log line
# "langgraph_checkpointer_memory_fallback" to confirm. The same fallback
# happens if the pool fails to open, so a bad value is also silent.
# For local dev, point this at the same database as DATABASE_URL.
NEON_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campaignforge


# === Redis ==================================================================

# Declared in Settings but currently READ BY NOTHING in backend/src. SSE
# streaming uses an in-process store (routers/campaigns.py), not Redis pub/sub.
# Blank/wrong breaks nothing today. Kept so docker-compose parity is obvious.
REDIS_URL=redis://localhost:6379


# === Auth (legacy/local JWT) ================================================

# Signs and verifies the HS256 tokens issued by POST /api/v1/auth/login and
# decoded by TenantMiddleware. Blank means the literal default
# "change-me-in-production" is used — every local token becomes forgeable, and
# tokens stop validating the moment the value changes. Required in production
# even when Clerk is on, because the SSE ?token= path still decodes locally.
JWT_SECRET=replace-with-64-char-random-string

# Algorithm for the local tokens. Only HS256 is exercised; changing it without
# changing the key type breaks login and TenantMiddleware together.
JWT_ALGORITHM=HS256

# Local token lifetime in minutes. Must be an int — blank is a startup
# validation error, not a fallback to 60.
JWT_EXPIRE_MINUTES=60


# === Clerk (production auth) ================================================

# Clerk is active ONLY when CLERK_JWKS_URL and CLERK_SECRET_KEY are BOTH set
# (dependencies.py). With either blank, the backend skips RS256 verification
# entirely and accepts only local HS256 tokens from /api/v1/auth/login — which
# is the intended dev/CI mode. With both set, a first-time Clerk sign-in
# auto-provisions Organization + User + free Subscription.
# Blank CLERK_SECRET_KEY alone also means no Clerk user-info lookup, so
# auto-provisioned users would have no email/name.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Optional demo-org routing. When DEMO_ORG_ID is set, first-time Clerk sign-ins
# whose email is in DEMO_ORG_ALLOWLIST (comma-separated) attach to that seeded
# org (db/seed.sql) instead of getting a fresh one. Blank = every new Clerk
# user gets their own org; the demo data is simply never shared.
DEMO_ORG_ID=
DEMO_ORG_ALLOWLIST=


# === LLM Providers ==========================================================
# Six providers. A provider whose API key is BLANK is skipped entirely — adding
# a key is the whole activation step. Per tier, the first provider in
# LLM_PROVIDER_ORDER that has a key becomes primary and the rest attach as
# LangChain .with_fallbacks(), so a transient 503 from one free-tier gateway
# does not kill a campaign. If NO provider has a key, get_llm() raises naming
# these variables — the API boots, then every campaign fails inside the first
# agent. Check GET /api/v1/health/llm (authenticated) for the resolved chain.

# --- Native SDK providers ---

# Anthropic (default primary for all three tiers). Blank disables Anthropic.
# Models are pinned in llm_provider.py, not configurable here:
# brain/worker = claude-sonnet-4-20250514, ad_copy = claude-3-5-haiku-20241022.
ANTHROPIC_API_KEY=

# Google Gemini. Blank disables Google. NOTE: this field accepts EITHER env
# name via AliasChoices — GOOGLE_API_KEY or GEMINI_API_KEY. Set one, not both.
GOOGLE_API_KEY=

# Model used for all three tiers when Google serves them. Blank = the empty
# string is passed to the SDK and every Gemini call fails; keep the default.
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI-compatible providers (all routed through ChatOpenAI + base_url) --

# Blank disables OpenAI.
OPENAI_API_KEY=
# Blank is FINE here — it means "use the official api.openai.com default".
# Set it only to point at a proxy or an OpenAI-compatible gateway.
OPENAI_BASE_URL=
# Blank breaks OpenAI calls (empty model id sent). Keep a value.
OPENAI_MODEL=gpt-4o-mini

# Blank disables NVIDIA NIM. Free tier caps concurrency and returns 503s under
# load, which is exactly why a second provider is worth configuring.
NVIDIA_NIM_API_KEY=
# Blank sends NIM requests to api.openai.com and they fail. Keep the default.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash

# Blank disables OpenRouter.
OPENROUTER_API_KEY=
# Blank sends OpenRouter requests to api.openai.com and they fail.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Blank disables Bonsai.
BONSAI_API_KEY=
# Blank sends Bonsai requests to api.openai.com and they fail.
BONSAI_BASE_URL=https://api.trybons.ai/v1
BONSAI_MODEL=gpt-4o-mini

# --- Routing ---

# Comma-separated preference order. Blank = the built-in default order
# anthropic,google,openai,nvidia,openrouter,bonsai. Unknown names are logged
# ("llm_unknown_providers_ignored") and dropped; if nothing valid remains, the
# default order is used anyway.
LLM_PROVIDER_ORDER=

# Pin one provider to a tier. Blank = normal order-based resolution WITH
# fallbacks (the recommended setting). A non-blank value means "use exactly
# this one" and DISABLES that tier's fallback chain — and raises at resolution
# time if the pinned provider's API key is unset or the name is unknown.
# Tiers: brain = Orchestrator + QA/Brand (temp 0.3), worker = Strategy +
# Content (0.7), ad_copy = Ad Copy (0.8), lite = SEO, repurpose and A/B
# variants (0.5, 1536-token ceiling).
#
# `lite` is the cost lever. Those calls reformat text they are handed rather
# than deciding anything, so they do not need the reasoning tier — on Anthropic
# it resolves to Haiku, 3x cheaper than the worker model. Pin it to your
# cheapest provider (e.g. LLM_LITE_PROVIDER=google) to cut blended spend
# without touching campaign quality.
LLM_BRAIN_PROVIDER=
LLM_WORKER_PROVIDER=
LLM_AD_COPY_PROVIDER=
LLM_LITE_PROVIDER=

# Override the model id for a tier. Blank = the provider's built-in model for
# that tier. Applies to the PRIMARY provider only — model ids are
# provider-specific, so forwarding one to a fallback would guarantee failure.
LLM_BRAIN_MODEL=
LLM_WORKER_MODEL=
LLM_AD_COPY_MODEL=
LLM_LITE_MODEL=


# === Stripe (billing) =======================================================

# Blank sets stripe.api_key = None, so every checkout/portal/subscription call
# raises. Plan metadata and quota limits still work; only real payments break.
STRIPE_SECRET_KEY=

# Blank makes POST /api/v1/billing/webhook reject every delivery (it returns
# early without a configured secret), so plan upgrades never land in the DB.
STRIPE_WEBHOOK_SECRET=

# Stripe price ids per plan. Blank falls back to the literal placeholders
# "price_starter" / "price_growth" / "price_agency", which are not real prices
# — checkout for that tier fails at Stripe. The free tier needs none.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=


# === Storage (S3/R2 for media) ==============================================
# Declared in Settings but currently READ BY NOTHING in backend/src — no boto3
# client exists yet. Blank breaks nothing today; present for forward
# compatibility with media upload.
S3_BUCKET_NAME=campaignforge-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# === AgentMail (transactional email) ========================================

# Blank means no transactional email is ever sent. Sending degrades gracefully:
# services/email_service.py returns sent=False with a reason and the calling
# request still succeeds (a team invite still creates the user and returns a
# temp password to share out of band).
AGENTMAIL_API_KEY=

# Shared sender inbox. Its domain must be a VERIFIED domain in AgentMail, or
# the inbox cannot be created and nothing sends. An org that has its own
# organization.agentmail_inbox_id overrides this per message.
AGENTMAIL_FROM_EMAIL=alerts@intelliforge.tech

# Fallback domain used only when AGENTMAIL_FROM_EMAIL is a bare username with
# no "@". Blank falls through to AgentMail's own agentmail.to domain.
AGENTMAIL_DEFAULT_DOMAIN=intelliforge.tech


# === OAuth (publishing connections) =========================================
# Per platform, a blank client id makes GET /api/v1/oauth/{platform}/authorize
# return 501 "not configured" — that platform simply cannot be connected, and
# publishing to it is unavailable. A blank secret lets the authorize step
# succeed and then fails the token exchange in the callback.
# The redirect URI is derived from the FIRST entry in CORS_ORIGINS, so that
# value must match the URL registered with each provider.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=


# === OAuth token encryption at rest (Fernet) ================================
# Blank + APP_ENV=dev  -> a hardcoded development key is used (fine locally,
#                         never for real tokens).
# Blank + APP_ENV!=dev -> get_fernet() raises, so storing or reading any
#                         platform OAuth token fails outright.
# Rotating this value makes previously stored tokens undecryptable; they are
# logged as "token_decrypt_legacy_plaintext" and returned as-is, so
# re-connect every platform account after a rotation.
#
# Generate a key (either form works, they do the same thing):
#   python -c "from agency.config import generate_token_encryption_key; print(generate_token_encryption_key())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=


# === Image generation (fal.ai) ==============================================

# Blank makes generate_social_image() return {"status": "skipped"} instead of
# an image URL. Campaigns still complete; posts just have no generated visual.
FAL_API_KEY=


# === Trends / Search (Exa) ==================================================

# Declared in Settings but currently READ BY NOTHING in backend/src —
# services/trends.py returns a hardcoded PLATFORM_TRENDS table regardless.
# Blank breaks nothing today; trend data is static either way.
EXA_API_KEY=


# === Slack ==================================================================

# Blank makes every Slack notification a no-op (services/slack_integration.py
# returns early). No alerts on campaign completion or failure.
SLACK_BOT_TOKEN=

# Blank makes the Slack webhook/slash-command endpoint reject all requests,
# because signature verification cannot run.
SLACK_SIGNING_SECRET=


# === CORS ===================================================================

# Accepts a JSON array string OR a comma-separated string. Blank means the
# browser gets no allowed origin and every frontend request fails CORS
# preflight. ALSO used to build OAuth redirect URIs — the first entry is
# treated as the app's own base URL, so order matters.
# Production value: https://campaignforge.intelliforge.tech
CORS_ORIGINS=http://localhost:3000


# === Frontend URL ===========================================================

# Base URL for Stripe Checkout success/cancel redirects when the client omits
# success_url / cancel_url. Blank falls back to http://localhost:3000 in code,
# which in production would bounce paying users to localhost.
# Production value: https://campaignforge.intelliforge.tech
FRONTEND_URL=http://localhost:3000
